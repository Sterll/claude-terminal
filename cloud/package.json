    "multer": "^2.4.0",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  }
