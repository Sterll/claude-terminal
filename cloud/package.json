{
  "name": "claude-terminal-cloud",
  "version": "0.1.0",
  "description": "Self-hosted relay & cloud server for Claude Terminal",
  "main": "dist/index.js",
  "bin": {
    "ct-cloud": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node ../scripts/copy-cloud-shared.js",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "test": "npm run build && node --test tests/reliability.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.42",
    "archiver": "^7.0.0",
    "dotenv": "^16.4.5",
