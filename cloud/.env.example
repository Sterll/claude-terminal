# ── Server ──
PORT=3800
HOST=0.0.0.0
PUBLIC_URL=https://cloud.example.com

# ── Cloud ──
# Cloud execution is personal: one user per container with dedicated volumes.
# Set false for a multi-user relay/sync instance without agent execution.
CLOUD_ENABLED=true
MAX_EXPANDED_SIZE=1gb
MAX_PROJECTS_PER_USER=20
MAX_SESSIONS=5

# ── Claude Credentials ──
CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json

# ── Limits ──
MAX_UPLOAD_SIZE=100mb
SESSION_TIMEOUT_HOURS=24
RATE_LIMIT_PER_MINUTE=120

# ── Security ──
ADMIN_TOKEN=
CORS_ORIGINS=*
